# ThreatLens AI — Environment Configuration Example
# Copy this file to .env and configure your API keys.

# Application Environment
APP_NAME="ThreatLens AI"
APP_ENV="development"
DATABASE_URL="sqlite:///./threatlens.db"

# Threat Intelligence Provider API Keys
# If left empty, the application runs in setup mode with clear configuration instructions.
VIRUSTOTAL_API_KEY=""
OTX_API_KEY=""

# HTTP Request Timeout for External Provider Lookups (seconds)
REQUEST_TIMEOUT_SECONDS=12.0

# CORS Allowed Origins (Comma-separated or list syntax)
# Frontend development server runs on port 5173 by default
