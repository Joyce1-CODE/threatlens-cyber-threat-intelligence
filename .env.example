# ThreatLens AI — Environment Configuration Template
# Copy this file to .env and configure your local environment settings.

# Application Environment
APP_NAME="ThreatLens AI"
APP_ENV="development"
DATABASE_URL="sqlite:///./threatlens.db"

# Threat Intelligence Provider API Keys (Passive Lookups)
# Obtain your free API keys:
# VirusTotal: https://www.virustotal.com/gui/join-us
# AlienVault OTX: https://otx.alienvault.com
VIRUSTOTAL_API_KEY=""
OTX_API_KEY=""

# HTTP Request Timeout for External Provider Lookups (seconds)
REQUEST_TIMEOUT_SECONDS=12.0

# Performance, Reliability & Rate-Limiting
MAX_RETRIES=2
RETRY_BASE_BACKOFF=1.0
CACHE_TTL_SECONDS=600

# Authentication & JWT Security (Generate a secure 256-bit random key for production: `openssl rand -hex 32`)
JWT_SECRET_KEY="replace_with_a_secure_random_secret_key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# Initial Bootstrap Administrator Account (Created automatically on first start if no users exist)
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_EMAIL="admin@threatlens.ai"
ADMIN_INITIAL_PASSWORD="Admin@ChangeMe123!"
